# Application Settings
ENVIRONMENT=development
APP_NAME=CMR-Specialist-Automation
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & Auth
SECRET_KEY=dev-secret-key-replace-in-production-change-me-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database & Vectors
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/friedin_cmr
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
EMBEDDING_DIM=1536

# Redis & Caching
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / Local)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage
S3_BUCKET=cmr-documents
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# LLM Provider Configuration
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Rate Limits & Quotas
RATE_LIMIT_PER_MINUTE=60
